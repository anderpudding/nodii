# 이 파일을 .env.local로 복사해서 값을 채웁니다. (.env.local은 커밋하지 않음)
# 로컬 개발: `pnpm db:start` 출력의 API URL과 Publishable key
# TestFlight: Supabase 프로젝트의 값 (빌드 시점에 앱에 포함됨)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# 심사 계정 이메일과 App Store 앱 ID (비밀번호는 넣지 않음)
VITE_REVIEW_ACCOUNT_EMAIL=
VITE_APP_STORE_ID=

# 설정의 법적 고지 및 지원 페이지 (HTTPS)
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_SUPPORT_URL=
