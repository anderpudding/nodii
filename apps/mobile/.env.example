# 이 파일을 .env.local로 복사해서 값을 채웁니다. (.env.local은 커밋하지 않음)
# 로컬 개발: `pnpm db:start` 출력의 API URL과 Publishable key
# EAS Build: 같은 키를 선택한 EAS environment에 등록합니다.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 심사 계정 이메일과 App Store 앱 ID (비밀번호는 넣지 않음)
EXPO_PUBLIC_REVIEW_ACCOUNT_EMAIL=
EXPO_PUBLIC_APP_STORE_ID=

# 설정의 법적 고지 및 지원 페이지 (HTTPS)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
