{
  "name": "@nodii/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --go --ios --localhost --clear",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && jest --runInBand",
