# 이 파일을 .env.local로 복사해서 값을 채웁니다. (.env.local은 커밋하지 않음)
# 로컬 개발: `pnpm db:start` 출력의 API URL과 Publishable key
# EAS Build: 같은 키를 선택한 EAS environment에 등록합니다.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVIEW_ACCOUNT_EMAIL=appreview@nodii.app
EXPO_PUBLIC_APP_STORE_ID=6812983213

EXPO_PUBLIC_PRIVACY_URL=https://nodii.app/privacy.html
EXPO_PUBLIC_TERMS_URL=https://nodii.app/terms.html
EXPO_PUBLIC_SUPPORT_URL=https://nodii.app/support.html
